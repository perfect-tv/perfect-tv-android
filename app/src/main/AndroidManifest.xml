<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- главный экран Android TV: ряд «Избранные» и «Продолжить просмотр» -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- копия в «Загрузки» на Android 9 и ниже (с 10 — через MediaStore без разрешения) -->
    <!-- установка скачанного обновления (core/Updater.kt) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- голосовой ввод в поиске: видеть, есть ли на устройстве распознавание речи (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="false"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.PerfectTv">

        <!-- открытие файла копии *.perfecttv: подтверждение восстановления. Менеджеры отдают файл по-разному
             (content:// или file://, с типом и без, расширение — в пути или только в имени), поэтому два фильтра и несколько шаблонов пути -->
        <activity
            android:name=".ui.RestoreActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.perfecttv" />
                <data android:pathPattern=".*\\..*\\.perfecttv" />
                <data android:pathPattern=".*\\..*\\..*\\.perfecttv" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.perfecttv" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.perfecttv" />
                <data android:pathPattern=".*\\..*\\.perfecttv" />
                <data android:pathPattern=".*\\..*\\..*\\.perfecttv" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.perfecttv" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/x-perfecttv" />
            </intent-filter>
        </activity>

        <!-- экран ошибки и диагностика — в отдельном процессе: основной после фатальной ошибки уже мёртв -->
        <activity
            android:name=".ui.CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:screenOrientation="landscape" />
        <activity
            android:name=".ui.ReportActivity"
            android:exported="false"
            android:process=":crash"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.TvActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- карточки главного экрана: perfecttv://channel?p=…&k=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="perfecttv" android:host="channel" />
            </intent-filter>
            <!-- голос: «Включи Первый канал в Perfect TV» -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SettingsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize" />

        <!-- скачанный APK обновления отдаётся установщику по content:// -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!-- баннеры карточек главного экрана: файлы из cacheDir/posters, читает лаунчер -->
        <provider
            android:name=".data.Posters$Provider"
            android:authorities="top.rootu.perfecttv.posters"
            android:exported="true" />

        <receiver android:name=".core.Alarms$Receiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
