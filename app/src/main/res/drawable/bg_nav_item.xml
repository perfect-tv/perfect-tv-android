<?xml version="1.0" encoding="utf-8"?>
<!-- Раздел настроек: в фокусе — белый, открытый (фокус справа) — серый -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/bg_white_s" />
    <item android:state_activated="true">
        <shape android:shape="rectangle"><solid android:color="@color/fill_active" /><corners android:radius="@dimen/radius_s" /></shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
