<?xml version="1.0" encoding="utf-8"?>
<!-- Текст и кнопки окон. Размер текста: 1 em = 10 sp -->
<resources>
    <style name="Text">
        <item name="android:textColor">@color/white</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- многострочный (описания) -->
    <style name="Text.Multi">
        <item name="android:singleLine">false</item>
        <item name="android:gravity">top</item>
    </style>

    <!-- заголовок окна -->
    <style name="Text.PopupTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- подпись под заголовком -->
    <style name="Text.Sub">
        <item name="android:textSize">11.5sp</item>
        <item name="android:textColor">@color/text_60</item>
    </style>

    <!-- кнопка окна: белая в фокусе (selected — фокус ведёт код, а не Android) -->
    <style name="Text.Button">
        <item name="android:textSize">12sp</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/text_sel</item>
        <item name="android:paddingStart">11dp</item>
        <item name="android:paddingEnd">11dp</item>
        <item name="android:paddingTop">5.5dp</item>
        <item name="android:paddingBottom">5.5dp</item>
        <item name="android:layout_marginEnd">@dimen/button_gap</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- кнопка инфопанели на сенсорных -->
    <style name="Text.InfoButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:paddingTop">4.5dp</item>
        <item name="android:paddingBottom">4.5dp</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- ряд кнопок внизу окна -->
    <style name="PopupButtons">
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/popup_pad</item>
        <item name="android:paddingEnd">@dimen/popup_pad</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- клавиша экранной клавиатуры PIN -->
    <style name="Text.PinKey">
        <item name="android:layout_width">54dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_margin">2.5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/text_sel</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
