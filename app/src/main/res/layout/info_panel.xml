<?xml version="1.0" encoding="utf-8"?>
<!--
  Инфопанель внизу экрана (ui/info.js плагина): логотип, канал, бейджи, часы, передача,
  шкала, «Далее»; на сенсорных — кнопки; раскрытое описание с баннером TMDB.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText"
    android:id="@+id/info_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginStart="@dimen/screen_pad"
    android:layout_marginEnd="@dimen/screen_pad"
    android:layout_marginBottom="15dp"
    android:background="@drawable/bg_panel"
    android:clickable="true"
    android:focusable="false"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="15dp"
    android:paddingBottom="10dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- подложку, отступ и бейдж номера рисует сам логотип (Logos) -->
        <ImageView
            android:id="@+id/info_logo"
            android:layout_width="80dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/info_channel"
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_75"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/info_badges"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="8.5sp" />

                <TextView
                    android:id="@+id/info_clock"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/text_90"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/info_title"
                style="@style/Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.5dp"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/info_start"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_70"
                    android:textSize="9.5sp" />

                <top.rootu.perfecttv.ui.InfoBar
                    android:id="@+id/info_bar"
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/info_end"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_70"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/info_next"
                style="@style/Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.5dp"
                android:textColor="@color/text_65" />

            <!-- кнопки на сенсорных (не ТВ), как в плагине; tag — действие -->
            <LinearLayout
                android:id="@+id/info_touch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView style="@style/Text.InfoButton" android:tag="prev" android:text="◀" />
                <TextView style="@style/Text.InfoButton" android:tag="pause" android:text="❚❚" />
                <TextView style="@style/Text.InfoButton" android:tag="next" android:text="▶" />
                <TextView style="@style/Text.InfoButton" android:tag="more" android:text="@string/about" />
                <TextView style="@style/Text.InfoButton" android:tag="guide" android:text="@string/guide" />
                <TextView style="@style/Text.InfoButton" android:tag="menu" android:text="@string/menu" />
                <TextView style="@style/Text.InfoButton" android:tag="history" android:text="@string/recent" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- раскрытое описание: баннер TMDB (или логотип канала), название, теги, текст -->
    <LinearLayout
        android:id="@+id/info_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/info_banner"
            android:layout_width="220dp"
            android:layout_height="124dp"
            android:layout_marginEnd="15dp"
            android:background="@drawable/bg_soft"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/info_more_title"
                style="@style/Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:singleLine="false"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/info_more_tags"
                style="@style/Text.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/info_more_text"
                style="@style/Text.Multi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="7"
                android:textColor="@color/text_80" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
