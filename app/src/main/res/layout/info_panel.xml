<?xml version="1.0" encoding="utf-8"?>
<!--
  Инфопанель внизу экрана, во всю ширину: фон — затемнение снизу (InfoPanel.Scrim), содержимое —
  в безопасной зоне. Логотип, канал и бейджи, передача, шкала и «ещё N мин», «Далее» (при
  перемотке на её месте — пузырь с целевым временем), часы; на сенсорных — кнопки; раскрытое
  описание с картинкой и «Далее на канале»; у закреплённой панели — строка подсказок клавиш.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText"
    android:id="@+id/info_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:clickable="true"
    android:focusable="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_pad"
    android:paddingTop="@dimen/info_fade"
    android:paddingEnd="@dimen/screen_pad"
    android:paddingBottom="@dimen/screen_pad_v"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- подложку, отступ и бейдж номера рисует сам логотип (Logos) -->
        <ImageView
            android:id="@+id/info_logo"
            android:layout_width="96dp"
            android:layout_height="66dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="14dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- высота строк панели задана: глифы из запасных шрифтов («⟲», «❚❚», эмодзи в названиях)
                 выше обычных, и панель с каруселью над ней прыгала бы от канала к каналу -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/info_channel"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="340dp"
                    android:textColor="@color/text_80"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/info_badges"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <top.rootu.perfecttv.ui.MarqueeTextView
                android:id="@+id/info_title"
                style="@style/Text"
                android:layout_width="match_parent"
                android:layout_height="29dp"
                android:layout_marginTop="2dp"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/info_start"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_75"
                    android:textSize="12.5sp" />

                <top.rootu.perfecttv.ui.InfoBar
                    android:id="@+id/info_bar"
                    android:layout_width="0dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="9dp"
                    android:layout_marginEnd="9dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/info_end"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_75"
                    android:textSize="12.5sp" />

                <!-- эфир: «ещё 22 мин»; архив: время кадра -->
                <TextView
                    android:id="@+id/info_remain"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- «Далее»; при перемотке вместо неё — пузырь под маркером шкалы (сдвигает код) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="5dp">

                <TextView
                    android:id="@+id/info_next"
                    style="@style/Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:textColor="@color/text_85"
                    android:textSize="13sp" />

                <!-- «Эфир» под красной чертой шкалы при перемотке архива (позицию задаёт код, рядом с пузырём) -->
                <TextView
                    android:id="@+id/info_live"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_seek_live"
                    android:paddingStart="8dp"
                    android:paddingTop="1.5dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="1.5dp"
                    android:text="@string/live"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/info_seek"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_seek"
                    android:paddingStart="8dp"
                    android:paddingTop="1.5dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="1.5dp"
                    android:textColor="@color/on_archive"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="invisible" />
            </FrameLayout>

            <!-- кнопки на сенсорных (не ТВ); tag — действие -->
            <LinearLayout
                android:id="@+id/info_touch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView style="@style/Text.InfoButton" android:tag="prev" android:text="◀" />
                <TextView style="@style/Text.InfoButton" android:tag="pause" android:text="❚❚" />
                <TextView style="@style/Text.InfoButton" android:tag="next" android:text="▶" />
                <TextView style="@style/Text.InfoButton" android:tag="more" android:text="@string/about" />
                <TextView style="@style/Text.InfoButton" android:tag="guide" android:text="@string/guide" />
                <TextView style="@style/Text.InfoButton" android:tag="menu" android:text="@string/menu" />
                <TextView style="@style/Text.InfoButton" android:tag="history" android:text="@string/recent" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/info_clock"
            style="@style/Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="@color/text_95"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- ширину картинки и колонки «Далее на канале» задаёт код долями ширины панели -->
    <!-- раскрытое описание: картинка (EPG, TMDB или логотип канала), теги, текст, «Далее на канале» -->
    <!-- выдвигается по высоте (InfoPanel.setMore), сверху — разделительная полоса -->
    <LinearLayout
        android:id="@+id/info_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/line_strong" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp">

            <ImageView
                android:id="@+id/info_banner"
                android:layout_width="220dp"
                android:layout_height="124dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_soft"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/info_more_tags"
                    style="@style/Text.Multi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:textColor="@color/text_65"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/info_more_text"
                    style="@style/Text.Multi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.12"
                    android:maxLines="6"
                    android:textColor="@color/text_85"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- «Далее на канале»: строки upnext_row добавляет код -->
            <LinearLayout
                android:id="@+id/info_upnext"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:text="@string/next_on_the_channel"
                    android:textColor="@color/text_50"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- подсказки клавиш (hint_item добавляет код): только у закреплённой панели -->
    <LinearLayout
        android:id="@+id/info_hints"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone" />
</LinearLayout>
