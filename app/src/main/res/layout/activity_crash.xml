<?xml version="1.0" encoding="utf-8"?>
<!-- Экран фатальной ошибки (процесс :crash): сообщение и три действия -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/screen_pad">

    <TextView
        style="@style/Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/crash_title"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/crash_message"
        style="@style/Text.Multi"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/text_70"
        android:textSize="12.5sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/crash_restart"
            style="@style/Text.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:text="@string/crash_restart" />

        <TextView
            android:id="@+id/crash_details"
            style="@style/Text.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:text="@string/crash_details" />

        <TextView
            android:id="@+id/crash_exit"
            style="@style/Text.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:text="@string/crash_exit" />
    </LinearLayout>
</LinearLayout>
