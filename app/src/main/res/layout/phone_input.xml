<?xml version="1.0" encoding="utf-8"?>
<!-- Окно «Ввод с телефона»: QR-код, адрес, пояснение, кнопка «Закрыть» -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/phone_title"
        style="@style/Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/phone_title"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/phone_qr"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="12dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/phone_url"
        style="@style/Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/phone_hint"
        style="@style/Text.Multi"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/phone_hint"
        android:textColor="@color/text_65"
        android:textSize="11.5sp" />

    <TextView
        android:id="@+id/phone_close"
        style="@style/Text.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:focusable="true"
        android:text="@string/close" />
</LinearLayout>
