<?xml version="1.0" encoding="utf-8"?>
<!-- Окно обновления: версия, что нового, прогресс загрузки, кнопки «Отмена» и «Обновить» -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/update_title"
        style="@style/Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/update_current"
        style="@style/Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_65"
        android:textSize="11.5sp" />

    <TextView
        android:id="@+id/update_notes"
        style="@style/Text.Multi"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="9"
        android:textColor="@color/text_85"
        android:textSize="12.5sp" />

    <ProgressBar
        android:id="@+id/update_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="340dp"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progressBackgroundTint="@color/text_65"
        android:progressTint="@color/text_sel"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/update_cancel"
            style="@style/Text.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:text="@string/hint_cancel" />

        <TextView
            android:id="@+id/update_ok"
            style="@style/Text.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:text="@string/update_do" />
    </LinearLayout>
</LinearLayout>
