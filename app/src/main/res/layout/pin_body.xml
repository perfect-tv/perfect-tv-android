<?xml version="1.0" encoding="utf-8"?>
<!--
  Ввод PIN: заголовок, набранные точки, подсказка; клавиатура (PAD) или круг (RING/ROWS).
  Клавиши клавиатуры — по порядку 1–9, ⌫, 0, «Готово» (tag — значение).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/popup_pad"
    android:paddingTop="14dp"
    android:paddingEnd="@dimen/popup_pad"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/pin_title"
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="14.5sp"
        android:textStyle="bold" />

    <top.rootu.perfecttv.ui.PinDots
        android:id="@+id/pin_dots"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/pin_hint"
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_65" />

    <LinearLayout
        android:id="@+id/pin_pad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView style="@style/Text.PinKey" android:tag="1" android:text="1" />
            <TextView style="@style/Text.PinKey" android:tag="2" android:text="2" />
            <TextView style="@style/Text.PinKey" android:tag="3" android:text="3" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView style="@style/Text.PinKey" android:tag="4" android:text="4" />
            <TextView style="@style/Text.PinKey" android:tag="5" android:text="5" />
            <TextView style="@style/Text.PinKey" android:tag="6" android:text="6" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView style="@style/Text.PinKey" android:tag="7" android:text="7" />
            <TextView style="@style/Text.PinKey" android:tag="8" android:text="8" />
            <TextView style="@style/Text.PinKey" android:tag="9" android:text="9" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView style="@style/Text.PinKey" android:tag="del" android:text="⌫" />
            <TextView style="@style/Text.PinKey" android:tag="0" android:text="0" />
            <TextView style="@style/Text.PinKey" android:tag="done" android:text="@string/done" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <top.rootu.perfecttv.ui.PinWheel
        android:id="@+id/pin_wheel"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/pin_help"
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="3"
        android:singleLine="false"
        android:textColor="@color/text_50"
        android:textSize="11sp" />
</LinearLayout>
