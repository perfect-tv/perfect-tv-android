<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка передачи: время, название, описание с прокруткой (высоту ограничивает код) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/popup_pad"
    android:paddingEnd="@dimen/popup_pad">

    <TextView
        android:id="@+id/details_time"
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_70" />

    <TextView
        android:id="@+id/details_title"
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="3"
        android:singleLine="false"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/details_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:fadingEdgeLength="30dp"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none"
        android:visibility="gone">

        <TextView
            android:id="@+id/details_desc"
            style="@style/Text.Multi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/text_80"
            android:textSize="10.5sp" />
    </ScrollView>
</LinearLayout>
