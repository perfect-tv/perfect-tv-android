<?xml version="1.0" encoding="utf-8"?>
<!-- Пункт настроек: название, подпись, значение справа; в фокусе — белый -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_settings_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="7dp"
    android:paddingEnd="10dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_title"
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:textColor="@color/text_sel"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/item_sub"
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:duplicateParentState="true"
            android:maxLines="2"
            android:singleLine="false"
            android:textColor="@color/text_sel_60"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/item_value"
        style="@style/Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:duplicateParentState="true"
        android:textColor="@color/text_sel_70"
        android:textSize="10.5sp" />
</LinearLayout>
