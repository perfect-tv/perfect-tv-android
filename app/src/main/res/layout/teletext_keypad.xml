<?xml version="1.0" encoding="utf-8"?>
<!--
  Клавиатура телетекста справа от страницы, как PIN «Google»: сверху круг d-pad с кнопками текущего
  ряда, ниже ряды по три кнопки (↑/↓ — ряд, ←/OK/→ — кнопка ряда). Цветные кнопки — tag r/g/y/b,
  стереть (del), индекс (idx), подстраницы назад/вперёд (prev/next). Ряды — по порядку, tag — значение.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup"
    android:orientation="vertical"
    android:padding="6dp">

    <top.rootu.perfecttv.ui.TeletextWheel
        android:id="@+id/ttx_wheel"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginBottom="4dp" />

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView style="@style/Text.PinKey" android:tag="1" android:text="1" />
        <TextView style="@style/Text.PinKey" android:tag="2" android:text="2" />
        <TextView style="@style/Text.PinKey" android:tag="3" android:text="3" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView style="@style/Text.PinKey" android:tag="4" android:text="4" />
        <TextView style="@style/Text.PinKey" android:tag="5" android:text="5" />
        <TextView style="@style/Text.PinKey" android:tag="6" android:text="6" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView style="@style/Text.PinKey" android:tag="7" android:text="7" />
        <TextView style="@style/Text.PinKey" android:tag="8" android:text="8" />
        <TextView style="@style/Text.PinKey" android:tag="9" android:text="9" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView style="@style/Text.PinKey" android:tag="0" android:text="0" />
        <TextView style="@style/Text.PinKey" android:tag="r" />
        <TextView style="@style/Text.PinKey" android:tag="del" android:text="⌫" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView style="@style/Text.PinKey" android:tag="g" />
        <TextView style="@style/Text.PinKey" android:tag="y" />
        <TextView style="@style/Text.PinKey" android:tag="b" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView style="@style/Text.PinKey" android:tag="prev" android:text="‹" />
        <TextView style="@style/Text.PinKey" android:tag="idx" android:text="100" android:textSize="13sp" />
        <TextView style="@style/Text.PinKey" android:tag="next" android:text="›" />
    </LinearLayout>

    <!-- диапазоны принятых страниц (заполняет код): текущий выделен; ширина — как у трёх кнопок -->
    <TextView
        android:id="@+id/ttx_ranges"
        style="@style/Text"
        android:layout_width="177dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="3"
        android:textColor="@color/text_65"
        android:textSize="11.5sp" />
</LinearLayout>
