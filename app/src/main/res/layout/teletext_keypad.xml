<?xml version="1.0" encoding="utf-8"?>
<!--
  Клавиатура телетекста справа от страницы: цифры, цветные кнопки (tag r/g/y/b), стереть (del),
  индекс (idx), стоп подстраниц (hold), фон (mix). Ряды — по порядку, tag — значение.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView style="@style/Text.PinKey" android:tag="1" android:text="1" />
        <TextView style="@style/Text.PinKey" android:tag="2" android:text="2" />
        <TextView style="@style/Text.PinKey" android:tag="3" android:text="3" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView style="@style/Text.PinKey" android:tag="4" android:text="4" />
        <TextView style="@style/Text.PinKey" android:tag="5" android:text="5" />
        <TextView style="@style/Text.PinKey" android:tag="6" android:text="6" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView style="@style/Text.PinKey" android:tag="7" android:text="7" />
        <TextView style="@style/Text.PinKey" android:tag="8" android:text="8" />
        <TextView style="@style/Text.PinKey" android:tag="9" android:text="9" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView style="@style/Text.PinKey" android:tag="0" android:text="0" />
        <TextView style="@style/Text.PinKey" android:tag="r" />
        <TextView style="@style/Text.PinKey" android:tag="del" android:text="⌫" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView style="@style/Text.PinKey" android:tag="g" />
        <TextView style="@style/Text.PinKey" android:tag="y" />
        <TextView style="@style/Text.PinKey" android:tag="b" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView style="@style/Text.PinKey" android:tag="idx" android:text="100" android:textSize="13sp" />
        <TextView style="@style/Text.PinKey" android:tag="hold" android:text="‖" />
        <TextView style="@style/Text.PinKey" android:tag="mix" android:text="◐" />
    </LinearLayout>
</LinearLayout>
