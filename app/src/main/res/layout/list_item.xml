<?xml version="1.0" encoding="utf-8"?>
<!-- Строка списка окна: выбранная (isSelected) — белая, текст и шкала — тёмные -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:clickable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="5.5dp"
    android:paddingEnd="8dp"
    android:paddingBottom="5.5dp">

    <ImageView
        android:id="@+id/item_logo"
        android:layout_width="30dp"
        android:layout_height="21dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_logo_row"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_title"
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:textColor="@color/text_sel"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/item_sub"
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1.5dp"
            android:duplicateParentState="true"
            android:textColor="@color/text_sel_60"
            android:textSize="11sp"
            android:visibility="gone" />

        <top.rootu.perfecttv.ui.ProgressLine
            android:id="@+id/item_progress"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="3.5dp"
            android:duplicateParentState="true"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
