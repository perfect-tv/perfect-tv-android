<?xml version="1.0" encoding="utf-8"?>
<!-- Набор номера канала: номер, логотип и название, ниже — подсказки для следующей цифры -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/osd"
    android:layout_width="290dp"
    android:layout_height="wrap_content"
    android:layout_gravity="top|start"
    android:layout_marginStart="@dimen/screen_pad"
    android:layout_marginTop="@dimen/screen_pad_v"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/osd_num"
            style="@style/Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/osd_logo"
            android:layout_width="40dp"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <TextView
            android:id="@+id/osd_name"
            style="@style/Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13.5sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/osd_hints"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
