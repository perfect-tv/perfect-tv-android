<?xml version="1.0" encoding="utf-8"?>
<!-- Экран просмотра: видео, над ним слой интерфейса (карусель, инфопанель, номер, окна), тост -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit"
        app:shutter_background_color="@color/black"
        app:keep_content_on_player_reset="true" />

    <!-- поток загружается: показывается, если буферизация дольше 0,6 с (Tv.showBuffering) -->
    <ProgressBar
        android:id="@+id/buffering"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/text_85"
        android:visibility="gone" />

    <!-- окна (Layer) добавляются сюда поверх панелей -->
    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include layout="@layout/carousel" />

        <include layout="@layout/info_panel" />

        <include layout="@layout/osd_number" />
    </FrameLayout>

    <include layout="@layout/toast" />
</FrameLayout>
