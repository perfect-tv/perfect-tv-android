<?xml version="1.0" encoding="utf-8"?>
<!-- Форма настроек: заголовок, пояснение; поля (form_field) и ряды кнопок (form_buttons) — ниже -->
<top.rootu.perfecttv.ui.FormView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="15dp"
    android:paddingEnd="18dp"
    android:paddingBottom="15dp">

    <TextView
        android:id="@+id/form_title"
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/form_hint"
        style="@style/Text.Sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="3"
        android:singleLine="false"
        android:visibility="gone" />
</top.rootu.perfecttv.ui.FormView>
