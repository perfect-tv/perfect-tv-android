<?xml version="1.0" encoding="utf-8"?>
<!-- Подтверждение удаления плейлиста: фокус — на «Отмена», случайное OK ничего не удаляет -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/delete_playlist"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/delete_playlist_message"
        style="@style/Text.Multi"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/text_85"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/delete_playlist_cancel"
            style="@style/Text.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:text="@string/hint_cancel" />

        <TextView
            android:id="@+id/delete_playlist_ok"
            style="@style/Text.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:text="@string/delete" />
    </LinearLayout>
</LinearLayout>
