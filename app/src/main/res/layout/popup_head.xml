<?xml version="1.0" encoding="utf-8"?>
<!-- Шапка окна: значок или логотип канала, заголовок, подзаголовок; справа — подпись или счётчик -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/popup_pad"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/popup_pad"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/head_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no"
        android:tint="@color/white"
        android:visibility="gone"
        tools:ignore="UseAppTint" />

    <ImageView
        android:id="@+id/head_logo"
        android:layout_width="34dp"
        android:layout_height="24dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/head_title"
            style="@style/Text.PopupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/head_subtitle"
            style="@style/Text.Sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1.5dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/head_side"
        style="@style/Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_60" />

    <!-- несколько напоминаний: «1 / 3» и подсказка листания -->
    <LinearLayout
        android:id="@+id/head_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/head_counter_text"
            style="@style/Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/up_down_others"
            android:textColor="@color/text_55"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
