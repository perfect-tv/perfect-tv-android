<?xml version="1.0" encoding="utf-8"?>
<!-- Напоминание: время, название, описание -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/popup_pad"
    android:paddingEnd="@dimen/popup_pad">

    <TextView
        android:id="@+id/reminder_time"
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_70" />

    <TextView
        android:id="@+id/reminder_title"
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="2"
        android:singleLine="false"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/reminder_desc"
        style="@style/Text.Multi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="4"
        android:textColor="@color/text_80"
        android:textSize="10.5sp" />
</LinearLayout>
